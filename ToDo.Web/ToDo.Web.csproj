    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToDo.ServiceDefaults\ToDo.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
