@inject TodoApiClient TodoApi

@* Brand *@
<div class="flex items-center gap-2.5 px-5 py-5">
    <img src="do2done.png" alt="Do2Done" class="w-8 h-8" />
    <span class="text-lg font-bold text-healdocs-text tracking-tight" style="font-family: 'Poppins', sans-serif;">Do2Done</span>
</div>

<nav class="flex flex-col gap-1 px-3 mt-2 flex-1 overflow-y-auto">
    <div class="flex items-center justify-between px-2 mb-1">
        <span class="text-xs font-semibold text-healdocs-text-muted uppercase tracking-wider">My Lists</span>
        <button @onclick="ToggleNewListForm" class="p-1 rounded-md hover:bg-healdocs-active-bg text-healdocs-text-muted hover:text-healdocs-active-text transition-colors" title="Add new list">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
        </button>
    </div>

    @if (showNewListForm)
    {
        <div class="px-2 mb-2">
            <div class="flex gap-1">
                <input type="text" placeholder="List name" @bind="newListName" @bind:event="oninput"
                       @onkeydown="HandleNewListKeyDown"
                       class="flex-1 px-3 py-1.5 rounded-lg border border-healdocs-border bg-white text-sm text-healdocs-text placeholder-healdocs-text-muted focus:outline-none focus:ring-2 focus:ring-healdocs-active-text/20 focus:border-healdocs-active-text" />
                <button @onclick="AddList" disabled="@(string.IsNullOrWhiteSpace(newListName))"
                        class="px-2 py-1.5 rounded-lg bg-healdocs-active-text text-white text-xs font-medium hover:bg-indigo-600 disabled:opacity-40 transition-colors">
                    Add
                </button>
            </div>
        </div>
    }

    @if (lists is not null)
    {
        @foreach (var list in lists)
        {
            <div class="px-2">
                <NavLink class="flex items-center justify-between gap-2 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors text-healdocs-text-muted hover:bg-healdocs-active-bg hover:text-healdocs-active-text group"
                         href="@($"lists/{list.Id}")" Match="NavLinkMatch.All" ActiveClass="!bg-healdocs-active-bg !text-healdocs-active-text">
                    <span class="flex items-center gap-3 min-w-0">
                        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15a2.25 2.25 0 0 1 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
                        </svg>
                        <span class="truncate">@list.Name</span>
                    </span>
                    <span class="shrink-0 text-xs bg-healdocs-active-text/10 text-healdocs-active-text px-2 py-0.5 rounded-full font-medium">@(list.ActiveCount + list.CompletedCount)</span>
                </NavLink>
            </div>
        }
    }
</nav>

@code {
    private TodoListDto[]? lists;
    private bool showNewListForm;
    private string newListName = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadLists();
    }

    private async Task LoadLists()
    {
        lists = await TodoApi.GetListsAsync();
    }

    private void ToggleNewListForm()
    {
        showNewListForm = !showNewListForm;
        newListName = "";
    }

    private async Task HandleNewListKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddList();
        if (e.Key == "Escape") showNewListForm = false;
    }

    private async Task AddList()
    {
        if (string.IsNullOrWhiteSpace(newListName)) return;
        await TodoApi.CreateListAsync(newListName.Trim());
        newListName = "";
        showNewListForm = false;
        await LoadLists();
    }
}
