@inherits LayoutComponentBase

<div class="flex min-h-screen bg-healdocs-bg">
    @* Desktop sidebar *@
    <aside class="hidden md:flex md:w-64 md:flex-col md:fixed md:inset-y-0 z-20">
        <div class="flex flex-col grow bg-transparent overflow-y-auto">
            <NavMenu />
        </div>
    </aside>

    @* Mobile sidebar overlay *@
    @if (showMobileNav)
    {
        <div class="fixed inset-0 z-30 md:hidden">
            <div class="fixed inset-0 bg-black/30" @onclick="() => showMobileNav = false"></div>
            <aside class="fixed inset-y-0 left-0 w-64 bg-healdocs-bg shadow-xl z-40 overflow-y-auto">
                <NavMenu />
            </aside>
        </div>
    }

    <div class="flex flex-col flex-1 md:pl-64">
        <header class="sticky top-0 z-10 flex items-center justify-between h-14 px-6 bg-transparent">
            <button class="md:hidden p-2 rounded-lg hover:bg-healdocs-active-bg text-healdocs-text-muted" @onclick="() => showMobileNav = true">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
            </button>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank"
               class="text-sm text-healdocs-text-muted hover:text-healdocs-active-text transition-colors ml-auto">
                About
            </a>
        </header>

        <main class="flex-1 p-6">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" class="hidden fixed bottom-0 left-0 right-0 z-50 bg-amber-50 text-amber-900 px-5 py-3 shadow-[0_-1px_4px_rgba(0,0,0,0.1)]">
    An unhandled error has occurred.
    <a href="" class="underline font-medium">Reload</a>
    <a class="dismiss absolute right-3 top-2 cursor-pointer">&#10005;</a>
</div>

@code {
    private bool showMobileNav;
}
