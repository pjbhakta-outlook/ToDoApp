@page "/"

@inject TodoApiClient TodoApi
@inject NavigationManager Nav

<PageTitle>Do2Done</PageTitle>

@code {
    protected override async Task OnInitializedAsync()
    {
        var lists = await TodoApi.GetListsAsync();
        if (lists.Length > 0)
        {
            Nav.NavigateTo($"/lists/{lists[0].Id}", replace: true);
        }
    }
}
