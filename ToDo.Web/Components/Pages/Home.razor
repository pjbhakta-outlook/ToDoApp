@page "/"

@inject TodoApiClient TodoApi

<PageTitle>Todo List</PageTitle>

<div class="space-y-6">
    @* Header *@
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-healdocs-text">Todo List</h1>
            <p class="mt-1 text-sm text-healdocs-text-muted">@DateTime.Now.ToString("d MMMM, yyyy")</p>
        </div>

        <div class="flex items-center gap-3">
            <div class="relative">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-healdocs-text-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
                <input type="text" placeholder="Search List"
                       @bind="searchQuery" @bind:event="oninput"
                       class="pl-10 pr-4 py-2 w-56 rounded-xl border border-healdocs-border bg-white text-sm text-healdocs-text placeholder-healdocs-text-muted focus:outline-none focus:ring-2 focus:ring-healdocs-active-text/20 focus:border-healdocs-active-text transition-all" />
            </div>
            <button @onclick="() => showAddForm = !showAddForm"
                    class="flex items-center gap-2 px-5 py-2 rounded-xl bg-healdocs-accent text-white text-sm font-semibold shadow-sm hover:bg-red-600 active:bg-red-700 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Add New Task
            </button>
        </div>
    </div>

    @* Add Task Form *@
    @if (showAddForm)
    {
        <div class="rounded-2xl bg-white p-5 shadow-sm border border-healdocs-border">
            <div class="flex flex-col sm:flex-row gap-3">
                <input type="text" placeholder="Task title" @bind="newTitle"
                       class="flex-1 px-4 py-2 rounded-xl border border-healdocs-border text-sm text-healdocs-text placeholder-healdocs-text-muted focus:outline-none focus:ring-2 focus:ring-healdocs-active-text/20 focus:border-healdocs-active-text" />
                <input type="text" placeholder="Description (optional)" @bind="newDescription"
                       class="flex-1 px-4 py-2 rounded-xl border border-healdocs-border text-sm text-healdocs-text placeholder-healdocs-text-muted focus:outline-none focus:ring-2 focus:ring-healdocs-active-text/20 focus:border-healdocs-active-text" />
                <button @onclick="AddTask" disabled="@isLoading"
                        class="px-5 py-2 rounded-xl bg-healdocs-active-text text-white text-sm font-semibold hover:bg-indigo-600 active:bg-indigo-700 transition-colors disabled:opacity-50">
                    Add
                </button>
            </div>
        </div>
    }

    @* Tabs *@
    <div class="flex gap-1 border-b border-healdocs-border">
        <button @onclick='() => activeTab = "active"'
                class="px-5 py-2.5 text-sm font-medium transition-colors @(activeTab == "active" ? "text-healdocs-active-text border-b-2 border-healdocs-active-text" : "text-healdocs-text-muted hover:text-healdocs-text")">
            Active Task
        </button>
        <button @onclick='() => activeTab = "completed"'
                class="px-5 py-2.5 text-sm font-medium transition-colors @(activeTab == "completed" ? "text-healdocs-active-text border-b-2 border-healdocs-active-text" : "text-healdocs-text-muted hover:text-healdocs-text")">
            Completed
        </button>
    </div>

    @* Loading State *@
    @if (todos is null)
    {
        <div class="flex items-center gap-3 py-8 text-healdocs-text-muted">
            <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
            </svg>
            <span class="text-sm font-medium">Loading tasks...</span>
        </div>
    }
    else
    {
        @* Task Cards Grid *@
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var task in FilteredTodos)
            {
                <div class="rounded-2xl p-5 shadow-sm border border-white/60 transition-all hover:shadow-md @GetCardColor(task.Id)">
                    <div class="flex items-start justify-between">
                        <div class="flex items-start gap-3">
                            <label class="relative mt-0.5 flex items-center">
                                <input type="checkbox" checked="@task.IsCompleted" @onchange="() => ToggleTask(task.Id)"
                                       class="peer w-5 h-5 rounded-md border-2 border-gray-300 appearance-none checked:bg-healdocs-active-text checked:border-healdocs-active-text cursor-pointer transition-colors" />
                                <svg class="absolute w-3 h-3 left-1 top-1 text-white opacity-0 peer-checked:opacity-100 pointer-events-none" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                                </svg>
                            </label>
                            <div>
                                <h3 class="font-semibold text-healdocs-text @(task.IsCompleted ? "line-through opacity-50" : "")">@task.Title</h3>
                                <p class="mt-1 text-sm text-healdocs-text-muted leading-relaxed">@task.Description</p>
                            </div>
                        </div>
                        <button @onclick="() => DeleteTask(task.Id)" class="p-1 rounded-lg hover:bg-black/5 text-healdocs-text-muted hover:text-red-500 transition-colors" title="Delete task">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                        </button>
                    </div>
                    <div class="mt-4 text-xs text-healdocs-text-muted font-medium">
                        @task.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                    </div>
                </div>
            }
        </div>

        @if (!FilteredTodos.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 text-healdocs-text-muted">
                <svg class="w-16 h-16 mb-4 opacity-30" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15a2.25 2.25 0 0 1 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
                </svg>
                <p class="text-lg font-medium">@(activeTab == "active" ? "No active tasks" : "No completed tasks")</p>
                <p class="text-sm mt-1">@(activeTab == "active" ? "Add a new task to get started" : "Complete some tasks to see them here")</p>
            </div>
        }
    }
</div>

@code {
    private string activeTab = "active";
    private string searchQuery = "";
    private bool showAddForm;
    private bool isLoading;
    private string newTitle = "";
    private string newDescription = "";

    private TodoItemDto[]? todos;

    private IEnumerable<TodoItemDto> FilteredTodos => (todos ?? [])
        .Where(t => activeTab == "active" ? !t.IsCompleted : t.IsCompleted)
        .Where(t => string.IsNullOrEmpty(searchQuery) || t.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private static readonly string[] cardColors = ["bg-healdocs-card-pink", "bg-healdocs-card-lavender", "bg-healdocs-card-yellow", "bg-healdocs-card-green"];

    protected override async Task OnInitializedAsync()
    {
        await LoadTodos();
    }

    private async Task LoadTodos()
    {
        todos = await TodoApi.GetTodosAsync();
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;

        isLoading = true;
        await TodoApi.CreateTodoAsync(newTitle.Trim(), newDescription.Trim());
        newTitle = "";
        newDescription = "";
        showAddForm = false;
        await LoadTodos();
        isLoading = false;
    }

    private async Task ToggleTask(int id)
    {
        await TodoApi.ToggleTodoAsync(id);
        await LoadTodos();
    }

    private async Task DeleteTask(int id)
    {
        await TodoApi.DeleteTodoAsync(id);
        await LoadTodos();
    }

    private string GetCardColor(int id) => cardColors[id % cardColors.Length];
}
